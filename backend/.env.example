# ─────────────────────────────────────────────────────────────
#  FlowBoard AI — Backend Environment Variables
#  Copy this file to .env and fill in your values
# ─────────────────────────────────────────────────────────────

# Neon PostgreSQL connection string
# Get from: https://console.neon.tech → your project → Connection string
DATABASE_URL="postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/flowboard?sslmode=require"

# JWT secret — generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET="change_me_to_a_long_random_string"

# JWT expiry (e.g. 7d, 24h)
JWT_EXPIRES_IN="7d"

# Server port (frontend expects 5050 by default)
PORT=5050

# Frontend URL for CORS (no trailing slash)
CLIENT_URL="http://localhost:5173"

# AI Provider (google or openai)
AI_PROVIDER="google"

# Google Gemini API key (if AI_PROVIDER=google)
# Get from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY="your_gemini_api_key_here"

# OpenAI API key (if AI_PROVIDER=openai)
# OPENAI_API_KEY="your_openai_api_key_here"

# Node environment
NODE_ENV="development"

